{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "forge.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "out", "src/**/*.test.ts"]
}
