{
  "name": "@confuse/desktop",
  "version": "0.1.0",
  "description": "Confuse macOS desktop shell",
  "license": "MIT",
  "private": true,
  "productName": "Confuse",
  "main": "dist/main/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:images": "node scripts/build-images.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "package": "node scripts/build.mjs && electron-forge package",
    "make": "node scripts/build.mjs && electron-forge make",
    "make:mac": "node scripts/build.mjs && electron-forge make --platform=darwin --arch=arm64,x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@langfuse/otel": "6.1.0",
    "@langfuse/tracing": "6.1.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/sdk-trace-node": "~2.12.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "electron": "^40.0.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.90.0",
    "typescript": "catalog:",
    "vitest": "^4.1.12"
  }
}
